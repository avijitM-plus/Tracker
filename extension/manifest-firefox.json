{
  "manifest_version": 2,
  "name": "NeuroTrack Extension",
  "version": "1.0",
  "description": "Tracks active tab for NeuroTrack",
  "permissions": ["tabs", "activeTab", "storage", "http://localhost:8000/*", "http://127.0.0.1:8000/*", "<all_urls>"],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@neurotrack.local"
    }
  }
}
