{
  "manifest_version": 3,
  "name": "NeuroTrack Extension",
  "version": "1.0",
  "description": "Tracks active tab for NeuroTrack",
  "permissions": ["tabs", "activeTab", "storage"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@neurotrack.local",
      "strict_min_version": "109.0"
    }
  }
}
